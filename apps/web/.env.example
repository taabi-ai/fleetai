# --- Web (apps/web) ---
# Base URL of the gateway. The web app never talks to services or DBs directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Session secret (same value as the legacy NEXTAUTH_SECRET during transition).
NEXTAUTH_SECRET=
AUTH_SECRET=
# Disabled outside the Abacus host (see prompt 11 §5).
NEXT_PUBLIC_ENABLE_APPLLM=0
