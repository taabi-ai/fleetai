# --- Gateway (apps/gateway) ---
# LEGACY_URL=http://localhost:3001
# IDENTITY_URL=http://localhost:4001
# NEXTAUTH_SECRET=

# --- Database ---
# DATABASE_URL=postgresql://fleetai:fleetai@localhost:5432/postgres

# --- Messaging ---
# KAFKA_BROKERS=localhost:9092
# REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=fleetai-private
# S3_PUBLIC_BUCKET=fleetai-public
# S3_ACCESS_KEY=fleetai
# S3_SECRET_KEY=fleetai-dev-secret
# S3_FORCE_PATH_STYLE=true

# --- Security ---
# INTERNAL_HMAC_SECRET=<openssl rand -base64 32>
# CONFIG_SECRETS_KEY=<openssl rand -base64 32>
# AI_SECRETS_KEY=<openssl rand -base64 32>

# --- Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOG_LEVEL=info
