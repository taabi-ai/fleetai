# --- Required ---
# PostgreSQL connection string (Prisma). Example for docker compose: postgresql://fleet:fleet@db:5432/fleetai
DATABASE_URL=
# 32+ random bytes, e.g. `openssl rand -base64 32`. Both names are read by Auth.js v5.
NEXTAUTH_SECRET=
AUTH_SECRET=
# Public URL of the app (used for auth callbacks, emails and absolute links)
NEXTAUTH_URL=http://localhost:3000

# --- Optional ---
# Built-in AI provider (Abacus.AI RouteLLM). If omitted, configure a provider in Admin -> LLM providers.
ABACUSAI_API_KEY=
# Node environment
NODE_ENV=production
